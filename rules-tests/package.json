{
  "name": "@lailark/rules-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Firestore and Storage security rules, tested against the emulator.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project lailark --config ../firebase.json \"vitest run\"",
    "test:only": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@lailark/shared": "0.0.0",
    "eslint": "9.39.5",
    "firebase": "12.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
