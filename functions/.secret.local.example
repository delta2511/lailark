# Copy to `functions/.secret.local` (gitignored) for the emulator.
#
# Real values live in Secret Manager on the two Firebase projects `.firebaserc`
# names: `lailark` (alias `default`, production) and `tree-quiz-74e04` (alias
# `staging`). They are set with
# `firebase functions:secrets:set <NAME> --project <alias>`.
# Nothing in this file is ever a real secret (CLAUDE.md section 3).

# M1.6. Only ever accepted while the `users` collection is empty.
SETROLE_BOOTSTRAP_SECRET=local-emulator-only-not-a-real-secret

# M3.5, the web checkout. Left EMPTY on purpose: with no key configured the
# emulator branch of `functions/src/orders/razorpay.ts` returns a fake
# `order_emulator_<id>` and makes no network call, which is what keeps the
# test suite offline and off Razorpay's rate limit.
#
# To walk a real test payment locally, paste the Razorpay **test** keys here
# and never the live ones.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# M3.6, the Razorpay webhook. Left EMPTY on purpose: with none configured the
# emulator branch of `functions/src/orders/razorpay.ts` signs and verifies
# with `EMULATOR_WEBHOOK_SECRET`, a constant in that file, so the suite can
# post a correctly-signed body and prove that a wrong one is refused. A
# deployed project has `FUNCTIONS_EMULATOR` unset, so it never reaches that
# branch: with no secret there, the webhook answers 500 and verifies nothing.
RAZORPAY_WEBHOOK_SECRET=
