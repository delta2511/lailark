rules_version = '2';

// Lailark Kitchen — Firestore security rules.
//
// Default posture is deny. Anything not named here is unreachable from the
// public internet. The Firebase console and the Admin SDK bypass these rules,
// so Sumayya can always read everything from the console, and every Cloud
// Function writes whatever it needs regardless of what is written below.
//
// Three things this file is responsible for, from brief section 18.2:
//
//   1. Nothing is public. Two exceptions, both carried over from v0: a create
//      on `notify`, and a read of `config/site`.
//   2. No client ever writes money. `orders`, `documents`, `counters`,
//      `refunds`, `settlements`, `webhookEvents` and `dayCloses` take no
//      client write at all, not even from the Owner. Functions write them.
//   3. The Kitchen role may change only kitchen fields on a batch, checked by
//      comparing which keys changed.
//
// Roles come from the `role` custom claim on the Firebase Auth token, set by
// the `setRole` callable (M1.6). A signed-in user with no claim can read their
// own `users` document and nothing else. The role table is brief section
// 17.12; the access matrix below is that table as far as rules can express it.
// Anything the table gives a role that is a *transition* rather than a field
// write (open a batch, approve, discount, refund, broadcast) is enforced in
// the callable that performs it, not here, because rules cannot see a cap in
// Settings or a state machine.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── who is asking ──────────────────────────────────────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    // '' for a signed-out caller and for a signed-in one with no claim, so no
    // comparison below can throw on a missing key.
    function role() {
      return (signedIn() && ('role' in request.auth.token)) ? request.auth.token.role : '';
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isKitchen() {
      return role() == 'kitchen';
    }

    function isViewer() {
      return role() == 'viewer';
    }

    /** Any of the three roles: somebody on the Lailark admin list. */
    function isAdmin() {
      return isOwner() || isKitchen() || isViewer();
    }

    /** The two who do the work. Viewer is read-only, everywhere, always. */
    function isStaff() {
      return isOwner() || isKitchen();
    }

    /** May see Money: brief 17.12 row "See Money". */
    function seesMoney() {
      return isOwner() || isViewer();
    }

    /* ── which keys changed ─────────────────────────────────────────────── */

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /** This update changes nothing outside `keys`. */
    function onlyChanged(keys) {
      return changedKeys().hasOnly(keys);
    }

    /** This update changes at least one of `keys`. */
    function touches(keys) {
      return changedKeys().hasAny(keys);
    }

    /* ── the two batch field lists ──────────────────────────────────────── */
    //
    // Kept identical to PROTECTED_BATCH_FIELDS and KITCHEN_BATCH_FIELDS in
    // `shared/src/rules.ts`, which is what the admin reads to grey out the
    // inputs a role may not touch. `rules-tests/` parses the two arrays out of
    // this file and asserts the sets match, so they cannot drift.

    /** Counts and server-computed fields. No client writes these, ever. */
    function protectedBatchFields() {
      return [
        'batchNo',
        'bestBefore',
        'bookableJars',
        'bottledJars',
        'fullApprovedAt',
        'fullReachedAt',
        'halfApprovedAt',
        'halfReachedAt',
        'heldJars',
        'paidCount',
        'pausedFrom',
        'perPersonLimit',
        'pnl',
        'saleStopOn',
        'state',
        'writtenOff'
      ];
    }

    /* ── a batch's costs, checked by value ──────────────────────────────── */
    //
    // CLAUDE.md section 3: money is integers in paise, never floats. `costs`
    // is the one money field a client writes directly, straight from the
    // Bottling section of the Batches screen: no callable sees it, so these
    // rules are the last line of defence. Checking which keys changed is not
    // enough, because the *value* is what a typed box controls, and
    // `parseRupeesToPaise("-50")` is a perfectly well-formed -5000.
    //
    // The four lines are brief 17.4's "jar and lid cost, box and insert cost,
    // labelling and stickering cost" plus 14.1's gas and power. The key list
    // is closed so no fifth cost can be smuggled in unchecked, and
    // `get(key, 0)` means a map that simply omits one is read as zero rather
    // than refused.

    function batchCostLines() {
      return ['boxInserts', 'gasPower', 'jarsLids', 'labelling'];
    }

    function costLineOk(costs, key) {
      return costs.get(key, 0) is int && costs.get(key, 0) >= 0;
    }

    /** True when this write carries no `costs`, or a `costs` made of whole paise, zero or more. */
    function costsOk() {
      return !('costs' in request.resource.data)
             || (request.resource.data.costs is map
                 && request.resource.data.costs.keys().hasOnly(batchCostLines())
                 && costLineOk(request.resource.data.costs, 'boxInserts')
                 && costLineOk(request.resource.data.costs, 'gasPower')
                 && costLineOk(request.resource.data.costs, 'jarsLids')
                 && costLineOk(request.resource.data.costs, 'labelling'));
    }

    /* ── one sellable price, the ₹649 MRP ceiling ────────────────── */
    //
    // Whole paise, at least one, never above the ₹649 MRP printed on the
    // jar (CLAUDE.md section 3). Shared by a batch's two prices and a
    // product's two, so the ceiling is written once. It lives up here with
    // the other shared helpers because the batch rules below the catalogue
    // block call it too.

    function sellablePaise(value) {
      return value is int && value >= 1 && value <= 64900;
    }

    /* ── a batch's two prices, checked by value (D40, M2.16) ─────────── */
    //
    // D40: the Owner edits `priceOpen` and `priceInStock` in place on every
    // batch, in any state, with no lock. That makes a batch's prices a raw
    // client write, exactly like `costs` above and like a product's two
    // prices below, so the same reasoning applies: checking *which* keys
    // changed says nothing about the number in them, and a typed box is
    // where a ₹650 comes from. `sellablePaise` is the same ceiling the
    // catalogue uses, stated once (CLAUDE.md section 3: whole paise, at
    // least one, never above the ₹649 MRP printed on the jar).
    //
    // Like `costsOk()` this reads the merged post-state, so it is asked on
    // every batch write whether or not that write touched a price. It can
    // only ever refuse, never admit.

    function batchPricesOk() {
      return (!('priceInStock' in request.resource.data)
              || sellablePaise(request.resource.data.priceInStock))
             && (!('priceOpen' in request.resource.data)
                 || sellablePaise(request.resource.data.priceOpen));
    }

    /* ── the Owner's own per-person cap (D44) ────────────────────── */
    //
    // `perPersonLimit` stays protected and server computed. Beside it sits
    // `perPersonLimitOverride`, which the Owner types: null (or absent) is
    // automatic and falls back to the computed quarter, and anything else
    // must be a whole number of jars, at least one. A zero or a fraction
    // here would silently become a cap nobody meant.

    function perPersonLimitOverrideOk() {
      return !('perPersonLimitOverride' in request.resource.data)
             || request.resource.data.perPersonLimitOverride == null
             || (request.resource.data.perPersonLimitOverride is int
                 && request.resource.data.perPersonLimitOverride >= 1);
    }

    /** Weights, dates, sourcing note and packaging costs. Kitchen's own. */
    function kitchenBatchFields() {
      return [
        'cookedOn',
        'costs',
        'landedOn',
        'packedOn',
        'source',
        'updatedAt',
        'updatedBy',
        'weightCleaned',
        'weightCooked',
        'weightRaw'
      ];
    }

    /* ══ public ═════════════════════════════════════════════════════════ */

    // ── notify ────────────────────────────────────────────────────────────
    // The "tell me when a batch opens" list. Create-only from the public:
    // anyone may add themselves, nobody on the public internet may read the
    // list back. It holds phone numbers, so a public read would be a
    // scrapeable contact dump. The three admin roles may read it, because the
    // admin has to message the list when a batch opens.
    //
    // The field allowlist and the size caps are what bound abuse: no
    // arbitrary documents, no large payloads, no edits or deletes after
    // the fact.
    match /notify/{doc} {
      allow read: if isAdmin();
      allow update, delete: if false;

      allow create: if request.resource.data.keys().hasOnly(['contact', 'source', 'createdAt'])
                    && request.resource.data.contact is string
                    && request.resource.data.contact.size() >= 6
                    && request.resource.data.contact.size() <= 120
                    && request.resource.data.source is string
                    && request.resource.data.source in ['index', 'batch-001']
                    && request.resource.data.createdAt is timestamp;
    }

    // ── config ────────────────────────────────────────────────────────────
    // Public, read-only switches the site reads at page load. Only the one
    // named document is exposed, and writes are console-only (the Admin SDK
    // bypasses these rules), so nothing on the public internet can flip a
    // switch, and neither can the admin app. Currently holds:
    // notifyCtaVisible (bool) — shows/hides the "tell me when a batch opens"
    // WhatsApp link on the homepage.
    match /config/site {
      allow read: if true;
      allow write: if false;
    }

    /* ══ money: server only ═════════════════════════════════════════════ */
    //
    // CLAUDE.md section 3 and brief 18.2. Every collection in this block takes
    // no client write in any role. Reads follow the "See Money" row of 17.12:
    // Owner and Viewer yes, Kitchen no. `counters` and `webhookEvents` are
    // plumbing nobody reads from a client at all.

    /** Bills, receipts, refund notes, credit notes. Id is the number itself. */
    match /documents/{documentId} {
      allow read: if seesMoney();
      allow write: if false;
    }

    /** Next number per series. Changed only inside the server transaction. */
    match /counters/{series} {
      allow read, write: if false;
    }

    match /refunds/{refundId} {
      allow read: if seesMoney();
      allow write: if false;
    }

    match /settlements/{razorpayId} {
      allow read: if seesMoney();
      allow write: if false;
    }

    /** Written with a must-not-exist create by the webhook handler. */
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    /** The day's close. Written by the day-close function (M2.11). */
    match /dayCloses/{date} {
      allow read: if seesMoney();
      allow write: if false;
    }

    /* ══ orders ═════════════════════════════════════════════════════════ */

    // Every order is created and changed by a callable: the counter sale, the
    // web checkout, the hold transaction, packing. None of them is a client
    // write, because every one of them either moves a count on the batch
    // document inside a transaction or touches `payment`, and brief 18.2 puts
    // both on the server. So: read for the three roles, no client write at
    // all, Owner included.
    //
    // M4.1 (packing) may want a narrow kitchen update here for the packing
    // note and jar numbers. If it does, it arrives as a field-limited rule
    // like the batch one below, never as a blanket update.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    /* ══ kitchen ════════════════════════════════════════════════════════ */

    // Decision D21c: the document id is the batch's **internal reference**
    // (`b-7f3a2c`), fixed for its whole life. The printed number is the
    // `batchNo` field, which is absent until bottling, is allocated from
    // `counters/batch` inside the Cooking -> Bottled transaction, and is on
    // `protectedBatchFields()` so no client can write one. Anything that
    // resolves a batch by its printed number queries that field, not this id.
    match /batches/{batchRef} {
      allow read: if isAdmin();

      // Owner opens a batch and sets its prices (17.12). A create here is the
      // draft body only: no counts, no state, no computed dates and no batch
      // number. `transitionBatch` (M2.3) puts it into `draft` and moves it
      // from there.
      allow create: if isOwner()
                    && !request.resource.data.keys().hasAny(protectedBatchFields())
                    && costsOk()
                    && batchPricesOk()
                    && perPersonLimitOverrideOk();

      // Owner: everything except the counts and the computed fields.
      // Kitchen: the weights, dates, sourcing note and costs, and nothing
      // else. Brief 18.2, "checked by comparing which keys changed".
      // `costsOk()` is asked first and of both roles: the costs map is money,
      // and the one money field a client writes to a batch without a callable
      // in the way. On a merge write `request.resource.data` is the merged
      // post-state, so this is checked on every update whether or not that
      // update touched the costs — which is the right way round, because it
      // can only ever refuse a write, never admit one.
      allow update: if costsOk()
                    && batchPricesOk()
                    && perPersonLimitOverrideOk()
                    && ((isOwner() && !touches(protectedBatchFields()))
                        || (isKitchen() && onlyChanged(kitchenBatchFields())));

      // A batch is archived, never deleted. Numbers are never reused.
      allow delete: if false;

      /** What the pot actually used. Both staff roles record actuals. */
      match /lines/{lineId} {
        allow read: if isAdmin();
        allow create, update: if isStaff();
        allow delete: if isOwner();
      }

      /**
       * A kitchen photo update. Decision D5: nothing reaches a customer
       * without the Owner. So Kitchen may write the photo and the line, and
       * only the Owner may stamp `approvedBy`; `sentAt` is the send, which is
       * a function, but the Owner is allowed it for a manual correction.
       */
      match /updates/{updateId} {
        allow read: if isAdmin();

        allow create: if isOwner()
                      || (isKitchen()
                          && request.resource.data.get('approvedBy', null) == null
                          && request.resource.data.get('sentAt', null) == null);

        allow update: if isOwner()
                      || (isKitchen()
                          && onlyChanged(['photoPath', 'kitchenLine', 'updatedAt', 'updatedBy'])
                          && resource.data.get('approvedBy', null) == null
                          && resource.data.createdBy == request.auth.uid);

        allow delete: if false;
      }

      /** A jar that will never be sold. Recorded, never edited away. */
      match /writeOffs/{writeOffId} {
        allow read: if isAdmin();
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    /* ══ catalogue ══════════════════════════════════════════════════════ */

    // Prices live on products, so products are the Owner's: 17.12 gives
    // "set prices" to Owner alone.
    /* ── a product's prices, checked by value ───────────────────────────── */
    //
    // CLAUDE.md section 3: money is integers in paise, and never above the
    // ₹649 MRP printed on the jar. A product's two prices are typed into a box
    // on the Products screen and written straight here with no callable in the
    // way, exactly like a batch's `costs`, so the same reasoning applies: the
    // screen checks, and these rules are what make the check true.
    //
    // The ceiling itself is `sellablePaise` above, shared with a batch's two
    // prices (D40, M2.16), so ₹649 is written once in this file.
    //
    // A custom line is what the kitchen may sell at the counter under this
    // product's name. Its amount is a price too, so it takes the same ceiling.
    // Rules cannot walk a list, so the count is capped and each entry checked
    // by hand; a longer list than this would need the lines to become their
    // own documents, which is a change to the data model, not to a rule.

    function productPricesOk() {
      return (!('priceInStock' in request.resource.data)
              || sellablePaise(request.resource.data.priceInStock))
             && (!('priceOpen' in request.resource.data)
                 || sellablePaise(request.resource.data.priceOpen));
    }

    // A custom line may legitimately be free (something thrown in with an
    // order), so the floor is 0 rather than 1 paise. The ceiling is the same.
    function customLineAmountOk(value) {
      return value is int && value >= 0 && value <= 64900;
    }

    function customLineOk(index) {
      return !(request.resource.data.customLines.size() > index)
             || customLineAmountOk(request.resource.data.customLines[index].amountPaise);
    }

    function customLinesOk() {
      return !('customLines' in request.resource.data)
             || (request.resource.data.customLines is list
                 && request.resource.data.customLines.size() <= 8
                 && customLineOk(0) && customLineOk(1) && customLineOk(2) && customLineOk(3)
                 && customLineOk(4) && customLineOk(5) && customLineOk(6) && customLineOk(7));
    }

    match /products/{slug} {
      allow read: if isAdmin();
      allow write: if isOwner() && productPricesOk() && customLinesOk();
    }

    // Ingredients and recipes, question Q4 (Shefin): "For now admin only, but
    // keep a switch to turn on that permission for kitchen in the future. The
    // kitchen can view all the ingredients and details though."
    //
    // So all three roles read every field. The Owner creates and edits. The
    // Kitchen creates and edits only while the Owner's switch
    // `settings/permissions.kitchenCanEditRecipes` is a literal `true`; a
    // missing document, a missing field or any other value is off. The switch
    // is a Settings document, so only the Owner can flip it (rule below), and
    // it is mirrored by KITCHEN_RECIPE_EDIT_SWITCH in `shared/src/rules.ts`.
    // Delete stays the Owner's whatever the switch says: a batch's lines and
    // history point at these documents.
    //
    // `isKitchen()` is checked before the switch, so an Owner, Viewer or
    // signed-out write never spends a document read on it.

    /** The Owner's Q4 switch. Missing or anything but `true` means off. */
    function kitchenCanEditRecipes() {
      return exists(/databases/$(database)/documents/settings/permissions)
             && get(/databases/$(database)/documents/settings/permissions).data.get('kitchenCanEditRecipes', false) == true;
    }

    /** Owner always; Kitchen only with the switch on. */
    function editsRecipes() {
      return isOwner() || (isKitchen() && kitchenCanEditRecipes());
    }

    match /ingredients/{ingredientId} {
      allow read: if isAdmin();
      allow create, update: if editsRecipes();
      allow delete: if isOwner();
    }

    match /recipes/{recipeId} {
      allow read: if isAdmin();
      allow create, update: if editsRecipes();
      allow delete: if isOwner();
    }

    /* ══ customers ══════════════════════════════════════════════════════ */

    // Both staff roles: a name typed wrong at the counter, an address fixed
    // before packing (17.12, "change address before packing"). Deletion is a
    // function (M4.10) because it has to reach documents and conversations
    // too, so no client delete.
    match /customers/{phone} {
      allow read: if isAdmin();
      allow create, update: if isStaff();
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if isAdmin();
        allow create, update: if isStaff();
        allow delete: if false;
      }
    }

    /* ══ shipping ═══════════════════════════════════════════════════════ */

    // Packing and booking a courier are both staff jobs (17.12), and
    // "edit packing cost" is explicitly Kitchen's. `packingCost` and
    // `courierCost` are money but they are money *out*, typed by hand from a
    // receipt, not a customer payment, so they are not on the server-only
    // list. The courier booking itself is a callable.
    match /shipments/{shipmentId} {
      allow read: if isAdmin();
      allow create, update: if isStaff();
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    /* ══ agent ══════════════════════════════════════════════════════════ */

    // Concerns and approvals are raised by functions and answered by the
    // Owner: 17.12 gives "Answer a Concern" and "Approve half, full, photo
    // update and broadcast" to Owner alone. Kitchen and Viewer read them.
    match /concerns/{concernId} {
      allow read: if isAdmin();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // An approval is raised by a trigger and answered through a callable. The
    // Owner's update right here is the fallback, not the road: the admin app
    // always answers through `answerApproval`, `transitionBatch` or
    // `approveBatchFull`, which decide what an answer may say.
    //
    // `sentAt` is the one field that must never be reachable from a client at
    // all. It is the record that a customer has actually been messaged, so a
    // client that can write it can make Lailark believe a message went out
    // that never did, or that one is finished with when it is still waiting.
    // Every callable deliberately leaves it alone and says so in a comment;
    // this is what makes that a fact rather than an intention. Sending lands
    // in M5 and will write it with the Admin SDK, which is not bound by these
    // rules.
    function approvalServerFields() {
      return ['sentAt', 'kind', 'batchRef', 'updateId', 'dueAt', 'dueAtSupersededBy'];
    }

    match /approvals/{approvalId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isOwner() && !touches(approvalServerFields());
      allow delete: if false;
    }

    // Every message in or out goes through the WhatsApp function, which logs
    // it. A client write here would be a message nobody sent.
    match /conversations/{phone} {
      allow read: if isAdmin();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    /* ══ system ═════════════════════════════════════════════════════════ */

    // Kitchen reads Settings because the counter needs the discount cap
    // (D17) and the shipping switch. Only the Owner changes them (17.12,
    // "Settings, users, keys, GST and shipping switches"). `settings/pincodes`
    // is one of these documents, and so is `settings/permissions`, which holds
    // the Q4 switch: the Kitchen can read it but never flip it.
    match /settings/{name} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // A signed-in admin may read their own users document, so the app can show
    // their name next to the role; the Owner may read all of them, for the
    // users screen. Nothing on the client may write it: roles are set by the
    // `setRole` callable through the Admin SDK, which bypasses these rules.
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // The text a customer agreed to, kept forever so an old order can be read
    // against the policy of its day.
    match /policyVersions/{versionId} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // The undo log. The admin write wrapper (M2.6) appends before/after on
    // every change either staff role makes, so both may create; nobody may
    // edit or remove an entry, or undo would be lying. `by` must be the
    // caller and `at` must be the server's clock, so an entry cannot be
    // backdated or pinned on somebody else.
    // An entry must describe a change that is really happening, in this same
    // commit. Without this an entry is just a document a signed-in staff
    // account may write, so anyone could append a page of history that never
    // occurred: a price that was never set, a weight nobody recorded, an undo
    // of a write that never happened. A trail that can be written to freely
    // answers "what did somebody type" rather than "what happened", and the
    // second is the only question worth keeping it for.
    //
    // `getAfter` reads the target document as it will be **after this commit**.
    // The wrapper (`admin/src/audit/write.ts`) always writes the change and
    // its entry in one batch, and always stamps `updatedAt` with the server
    // clock, so on a genuine write that stamp is this commit's own time. An
    // entry arriving on its own finds the target's `updatedAt` unchanged from
    // whenever it was really last touched, and is refused. The check is on the
    // document as it will be, not as it is, so the first write to a document
    // that does not exist yet (a new actuals line) carries its own entry the
    // same way every later one does.
    //
    // This costs one document read per entry, which at a few dozen writes a
    // day is nothing, and it is what makes the wrapper's promise a fact
    // rather than a comment. Functions are not bound by these rules and write
    // their own entries through the Admin SDK inside their transaction.
    function auditTarget() {
      return path('/databases/' + database + '/documents/' + request.resource.data.object);
    }

    function auditDescribesARealWrite() {
      return request.resource.data.object is string
             && request.resource.data.object.size() > 0
             && request.resource.data.object.size() < 900
             && existsAfter(auditTarget())
             && getAfter(auditTarget()).data.updatedAt == request.time;
    }

    match /audit/{entryId} {
      allow read: if isAdmin();
      allow create: if isStaff()
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.at == request.time
                    && auditDescribesARealWrite();
      allow update, delete: if false;
    }

    /* ══ everything else ════════════════════════════════════════════════ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
