{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lailark-site",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "emulators:start",
        "--only",
        "hosting",
        "--project",
        "lailark"
      ],
      "port": 5010
    },
    {
      "name": "lailark-site-static",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "site/scripts/serve-out.mjs"
      ],
      "port": 4300
    },
    {
      "name": "lailark-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "admin"
      ],
      "port": 5175
    }
  ]
}
